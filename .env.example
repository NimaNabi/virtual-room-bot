# Copy to .env and fill in. Never share or commit .env.

# Required: your Discord bot token (Developer Portal → your application → Bot → Reset Token)
DISCORD_TOKEN=
# Optional: your server's ID (needed only if the bot is in more than one server)
GUILD_ID=
# Optional: the Discord user ID that owns this installation (defaults to the server owner)
OWNER_ID=
# Optional: extra accounts with full owner visibility (comma-separated user IDs)
OWNER_EQUIVALENT_IDS=
# Optional: extra bot owners (comma-separated user IDs)
OWNER_IDS=

LOG_LEVEL=INFO
# Privileged intents: set true ONLY after switching them on in the Developer Portal (Bot → Privileged Gateway Intents)
MESSAGE_CONTENT_INTENT=false
PRESENCE_INTENT=false

# Music: a local Lavalink container. Remove "music" to run without music.
COMPOSE_PROFILES=music
# Any long random string (scripts/init-env.sh generates one)
LAVALINK_PASSWORD=

# Optional AI assistant (any OpenAI-compatible API). Off unless AI_ENABLED=true.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=

# Optional update notifications (owner-only). Off unless UPDATE_REPO is set. For the official public repository use
# UPDATE_REPO=NimaNabi/virtual-room-bot (no token needed). UPDATE_GITHUB_TOKEN is only for a PRIVATE fork: your own
# read-only fine-grained token ("Contents: read"). Git installs can instead run `bash scripts/update.sh check`.
UPDATE_REPO=
UPDATE_GITHUB_TOKEN=
